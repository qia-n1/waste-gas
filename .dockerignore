# 顶层 .dockerignore：用于 vocs-server / admin-backend / admin-frontend 的构建上下文
# 排除一切跟容器无关的大目录，保证构建上下文 < 200MB

# IDE / OS
.git
.gitignore
.idea
.vscode
.DS_Store
Thumbs.db
*.swp
*.swo
*.bak

# Python
**/__pycache__
**/*.py[cod]
*$py.class
*.so
**/.pytest_cache
**/.mypy_cache
**/.venv
**/venv
**/env
**/ENV

# Node
**/node_modules
**/dist
**/.vite

# 文档与样例（不进镜像）
*.docx
*.pdf
*.tex
*.aux
*.toc
*.out
*.log
~$*
说明文档.docx
启动指南.txt
README.md

# 数据 / CSV（运行时通过 volume 挂载）
vocs_realtime_data/
*.csv

# 测试文件
test_*.py
*_test.py

# 编译产物
*.exe
*.dll
*.dylib

# 日志与临时
backend/backend-stdout.log
backend/backend-stderr.log
nginx-1.28.0/logs

# 大目录：旧版本 / 同事用户端 / 单独打包的子项目，与本次 prod 部署无关
frontend/
backend/
client-frontend/
client-backend/
uniapp-client/
vocs-project/
nginx-1.28.0/
Postman测试/
src/

# ensemble_docker 由其自身目录作为 build context；根上下文不需要再包含一遍
models/new_VOC/

# 本地环境文件（防止泄漏）
.env
.env.*
!.env.example
